<?xml version="1.0" encoding="UTF-8"?>
<!--
    files here are served only through the application (PHP),
    never directly by IIS. Rejecting every file extension blocks direct
    downloads and script execution for anything stored in this folder.
-->
<configuration>
    <system.webServer>
        <security>
            <requestFiltering>
                <fileExtensions allowUnlisted="false" />
            </requestFiltering>
        </security>
        <directoryBrowse enabled="false" />
    </system.webServer>
</configuration>
